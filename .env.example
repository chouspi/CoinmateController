# Coinmate Account -> API credentials. Use a key without withdrawal permission.
COINMATE_CLIENT_ID=
COINMATE_PUBLIC_KEY=
COINMATE_PRIVATE_KEY=

# Generate for example with: openssl rand -hex 32
CONTROLLER_API_TOKEN=

# Hard safety limit for one maker purchase (including fees), in CZK.
MAX_MARKET_BUY_CZK=10000

# Hard safety limit for one market sale, in BTC.
MAX_MARKET_SELL_BTC=1

# A watch is renewed for 30 seconds by each heartbeat and polls every 5 seconds.
BALANCE_WATCH_TIMEOUT_SECONDS=30
BALANCE_WATCH_POLL_SECONDS=5

# Persistent idempotency and audit journal. The Compose volume mounts /data.
DATABASE_PATH=/data/coinmate-controller.db

# Server-managed maker purchases: poll every 5 seconds, replace after 30 seconds.
PURCHASE_POLL_SECONDS=5
PURCHASE_REPRICE_SECONDS=30
